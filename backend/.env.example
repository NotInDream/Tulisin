TULISIN_APP_NAME=Tulisin
TULISIN_API_PREFIX=/api/v1
TULISIN_DATABASE_URL=sqlite+aiosqlite:///./data/tulisin.db

TULISIN_AUDIO_DIR=./data/audio
TULISIN_AUDIO_URL_PREFIX=/audio

# Option: tiny | base | small | medium | large-v3 | large-v3-turbo
# Add the .en suffix for English-only audio (e.g. small.en) — faster.
TULISIN_WHISPER_MODEL=tiny
# Option: cpu | cuda | auto
TULISIN_DEVICE=cpu
# if cpu:  int8 (default) | int16 | float32 (most accurate, slower)
# if cuda: float16 (recommended) | int8_float16 | bfloat16 | float32
TULISIN_WHISPER_COMPUTE_TYPE=int8
# Audio language as an ISO-639-1 code: id | en | ja | ar | ... .
# Leave empty for automatic language detection.
TULISIN_WHISPER_LANGUAGE=
